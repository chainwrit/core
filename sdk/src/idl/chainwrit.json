        {
          "name": "agent",
          "docs": [
            "The agent requesting the payment. Signing proves it is the agent named in",
            "the mandate; it proves nothing about whether the payment is a good idea,",
            "which is exactly why the program checks the rules below."
          ],
          "signer": true,
          "relations": [
            "mandate"
          ]
        },
